# Copy to .env for local development; on Netlify, set the same names under Site configuration → Environment variables.
# Never commit the real values.

# The Facebook Page the site reads events, news and photos from, and a Page access token for it.
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Optional: the id of the Facebook album the photo section shows. Empty: the photo section is left out.
FB_GALLERY_ALBUM_ID=
